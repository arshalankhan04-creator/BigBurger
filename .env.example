# ============================================================
# BigBurger — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# ============================================================

# Supabase — Public client-side keys only (safe for frontend)
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️  NEVER add service_role keys here.
# ⚠️  Service role keys bypass all RLS and must ONLY be used
#     in secure server-side environments (never in the browser).
